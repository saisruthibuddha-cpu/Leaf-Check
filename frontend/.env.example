# =========================================================================
# Leaf Check - Frontend Environment Template
# Copy this file to .env or .env.local for local customizations
# =========================================================================

# Base URL for API requests. In development with Vite proxy, use /api
VITE_API_BASE_URL=/api

# Application Display Name
VITE_APP_NAME="Leaf Check"

# Enable preloaded offline demo mode (default: true)
VITE_DEMO_MODE=true

# Telemetry polling frequency in milliseconds
VITE_TELEMETRY_POLL_INTERVAL_MS=3000
