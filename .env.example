# =========================================================================
# Leaf Check - Root Master Environment Configuration
# =========================================================================

# --- Backend API Environment Variables ---
ENVIRONMENT=production
PROJECT_NAME="Leaf Check"
VERSION="1.0.0"
HOST=0.0.0.0
PORT=8000
WORKERS=2

# Security & CORS Origins (JSON list or wildcards)
# ALLOWED_ORIGINS=["http://localhost:3000", "https://leafcheck.agri.io"]

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./database/crop_health.db

# Neural Vision Model Weights
MODEL_PATH=ai/models/saved_models/crop_disease_model.pt
CONFIDENCE_THRESHOLD=50.0

# IoT Telemetry & Demo Mode
DEMO_MODE=true
MQTT_BROKER=localhost
MQTT_PORT=1883

# --- Frontend Client Environment Variables ---
VITE_API_BASE_URL=/api
VITE_APP_NAME="Leaf Check"
VITE_DEMO_MODE=true
VITE_TELEMETRY_POLL_INTERVAL_MS=3000
