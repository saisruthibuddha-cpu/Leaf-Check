# =========================================================================
# Leaf Check - Backend Environment Configuration Template
# Copy this file to .env for local customization
# =========================================================================

ENVIRONMENT=development
PROJECT_NAME="Leaf Check"
VERSION="1.0.0"
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Database Configuration
DATABASE_URL=sqlite:///./database/crop_health.db

# Neural Vision Model Configuration
MODEL_PATH=ai/models/saved_models/crop_disease_model.pt
CONFIDENCE_THRESHOLD=50.0

# IoT Telemetry & Fallback Mode
DEMO_MODE=true
MQTT_BROKER=localhost
MQTT_PORT=1883
